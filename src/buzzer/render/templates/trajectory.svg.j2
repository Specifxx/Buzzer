<svg xmlns="http://www.w3.org/2000/svg" width="{{ w|px }}" height="{{ h|px }}" viewBox="0 0 {{ w|px }} {{ h|px }}">
  <defs>
    <clipPath id="court-zone">
      <rect x="0" y="{{ clip_top|px }}" width="{{ w|px }}" height="{{ clip_h|px }}"/>
    </clipPath>
  </defs>
  <rect x="0" y="0" width="{{ w|px }}" height="{{ h|px }}" fill="{{ bg }}"/>

  <g clip-path="url(#court-zone)">
    {% for r in rings %}
    <circle cx="{{ hoop_x|px }}" cy="{{ hoop_y|px }}" r="{{ r|px }}" fill="none"
            stroke="{{ faint }}" stroke-width="{{ hairline|px }}"
            stroke-dasharray="{{ (hairline*3)|px }} {{ (hairline*7)|px }}"/>
    {% endfor %}
    {% if shot_ring %}
    <circle cx="{{ hoop_x|px }}" cy="{{ hoop_y|px }}" r="{{ shot_ring|px }}" fill="none"
            stroke="{{ accent }}" stroke-width="{{ hairline|px }}" opacity="0.45"
            stroke-dasharray="{{ (hairline*5)|px }} {{ (hairline*5)|px }}"/>
    {% endif %}
    <path d="{{ three_d }}" fill="none" stroke="{{ faint }}" stroke-width="{{ hairline|px }}"/>
    <line x1="{{ baseline[0]|px }}" y1="{{ baseline[1]|px }}" x2="{{ baseline[2]|px }}" y2="{{ baseline[3]|px }}"
          stroke="{{ ink }}" stroke-width="{{ hairline|px }}" opacity="0.6"/>
    <line x1="{{ backboard[0]|px }}" y1="{{ backboard[1]|px }}" x2="{{ backboard[2]|px }}" y2="{{ backboard[3]|px }}"
          stroke="{{ ink }}" stroke-width="{{ (hairline*2)|px }}"/>
    <circle cx="{{ hoop_x|px }}" cy="{{ hoop_y|px }}" r="{{ hoop_r|px }}" fill="none"
            stroke="{{ ink }}" stroke-width="{{ (hairline*1.6)|px }}"/>

    <path d="{{ arc_d }}" fill="none" stroke="{{ accent }}" stroke-width="{{ (hairline*2.4)|px }}"
          stroke-dasharray="{{ (hairline*7)|px }} {{ (hairline*5)|px }}" stroke-linecap="round"/>
    <circle cx="{{ shot_x|px }}" cy="{{ shot_y|px }}" r="{{ halo_r|px }}" fill="none"
            stroke="{{ accent }}" stroke-width="{{ hairline|px }}" opacity="0.6"/>
    <circle cx="{{ shot_x|px }}" cy="{{ shot_y|px }}" r="{{ dot_r|px }}" fill="{{ accent }}"/>
  </g>

  {% if text.distance_line %}
  <text x="{{ dist_label_x|px }}" y="{{ dist_label_y|px }}" font-family="{{ mono }}"
        font-size="{{ footer_fs|px }}" fill="{{ accent }}" text-anchor="{{ dist_label_anchor }}"
        letter-spacing="{{ (footer_fs*0.25)|px }}">{{ text.distance_line }}</text>
  {% endif %}

  <text x="{{ margin|px }}" y="{{ clock_y|px }}" font-family="{{ sans }}" font-weight="bold"
        font-size="{{ clock_fs|px }}" fill="{{ ink }}">{{ text.clock_line }}</text>
  <text x="{{ (w - margin)|px }}" y="{{ head_y1|px }}" font-family="{{ sans }}" font-weight="bold"
        font-size="{{ head_fs|px }}" fill="{{ ink }}" text-anchor="end"
        letter-spacing="{{ (head_fs*0.2)|px }}">{{ text.period_line }}</text>
  <text x="{{ (w - margin)|px }}" y="{{ head_y2|px }}" font-family="{{ sans }}"
        font-size="{{ (head_fs*0.62)|px }}" fill="{{ accent }}" text-anchor="end"
        letter-spacing="{{ (head_fs*0.16)|px }}">{{ text.stakes_line }}</text>

  <text x="{{ (w/2)|px }}" y="{{ score_y|px }}" font-family="{{ sans }}" font-weight="bold"
        font-size="{{ score_fs|px }}" fill="{{ ink }}" text-anchor="middle"
        letter-spacing="{{ (score_fs*0.08)|px }}">{{ text.score_line }}</text>
  <text x="{{ (w/2)|px }}" y="{{ footer_y|px }}" font-family="{{ mono }}"
        font-size="{{ footer_fs|px }}" fill="{{ ink }}" text-anchor="middle" opacity="0.75"
        letter-spacing="{{ (footer_fs*0.2)|px }}">{{ text.date_line }}</text>
</svg>
