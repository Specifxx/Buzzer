<svg xmlns="http://www.w3.org/2000/svg" width="{{ w|px }}" height="{{ h|px }}" viewBox="0 0 {{ w|px }} {{ h|px }}">
  <rect x="0" y="0" width="{{ w|px }}" height="{{ h|px }}" fill="{{ ink }}"/>

  {% for line in lines %}
  <text x="{{ margin|px }}" y="{{ line.y|px }}" font-family="{{ display }}"
        font-size="{{ line.fs|px }}"
        fill="{{ paper if line.tone == 'paper' else (accent if line.tone == 'accent' else accent2) }}"
        >{{ line.value }}</text>
  {% endfor %}

  <rect x="0" y="{{ band_top|px }}" width="{{ w|px }}" height="{{ band_h|px }}" fill="{{ accent }}"/>
  <text x="{{ (w/2)|px }}" y="{{ band_text_y|px }}" font-family="{{ display }}"
        font-size="{{ band_fs|px }}" fill="{{ ink }}" text-anchor="middle"
        letter-spacing="{{ (band_fs*0.02)|px }}">{{ band_text }}</text>

  <text x="{{ margin|px }}" y="{{ footer_y|px }}" font-family="{{ mono }}"
        font-size="{{ footer_fs|px }}" fill="{{ paper }}" opacity="0.7"
        letter-spacing="{{ (footer_fs*0.16)|px }}">{{ footer_left }}</text>
  <text x="{{ (w/2)|px }}" y="{{ footer_y|px }}" font-family="{{ mono }}"
        font-size="{{ footer_fs|px }}" fill="{{ accent2 }}" text-anchor="middle"
        letter-spacing="{{ (footer_fs*0.16)|px }}">{{ footer_mid }}</text>
  <text x="{{ (w - margin)|px }}" y="{{ footer_y|px }}" font-family="{{ mono }}"
        font-size="{{ footer_fs|px }}" fill="{{ paper }}" opacity="0.7" text-anchor="end"
        letter-spacing="{{ (footer_fs*0.16)|px }}">{{ footer_right }}</text>
</svg>
